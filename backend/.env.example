# DealFlow360 Environment Variables Template
# Copy this file to .env for local backend development

# Application Settings
APP_NAME="DealFlow360 API"
APP_ENV="development"
DEBUG=True

# API Router Prefix Strategy
API_V1_STR="/api/v1"

# Database Settings (Async PostgreSQL via asyncpg)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dealflow360

# Full Async DATABASE_URL Override (Optional)
# DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/dealflow360

# NOTE: Additional settings (JWT, Firebase, Redis, etc.) 
# will be introduced progressively in subsequent development phases.
